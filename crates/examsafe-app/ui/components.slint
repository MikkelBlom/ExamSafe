// Reusable, purely presentational components. No business logic lives here.
import { Theme, Icons } from "theme.slint";

export enum Phase { idle, checking, fixing, verifying, ready, exam-mode, restoring, restored, failed }

// state: 0 = pending, 1 = active, 2 = done (mirrors examsafe_core::steps::StepState).
export struct StepItem {
    label: string,
    state: int,
}

export struct PlanItem {
    category: string,
    name: string,
    method: string,
    enabled: bool,
}

export component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <color> tint: Theme.accent;
    callback clicked();

    height: 52px;
    border-radius: 14px;
    background: !root.enabled ? Theme.muted-fill
        : touch.pressed ? root.tint.darker(0.15)
        : touch.has-hover ? root.tint.brighter(0.08)
        : root.tint;
    drop-shadow-blur: 22px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: root.enabled ? root.tint.transparentize(0.72) : transparent;
    animate background, drop-shadow-color { duration: Theme.medium; easing: ease-out; }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.enabled ? #ffffff : Theme.text-secondary;
        font-family: Theme.font-text;
        font-size: 16px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        animate color { duration: Theme.medium; }
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

export component LinkButton inherits Rectangle {
    in property <string> text;
    in property <string> icon: "";
    callback clicked();

    height: 32px;
    width: row.preferred-width + 20px;
    border-radius: 8px;
    background: touch.has-hover ? Theme.surface-hover : transparent;
    animate background { duration: Theme.fast; }

    row := HorizontalLayout {
        x: 10px;
        height: parent.height;
        spacing: 6px;
        if root.icon != "": Text {
            text: root.icon;
            font-family: Theme.font-icons;
            font-size: 11px;
            vertical-alignment: center;
            color: touch.has-hover ? Theme.text-primary : Theme.text-secondary;
        }
        Text {
            text: root.text;
            font-family: Theme.font-text;
            font-size: 13px;
            vertical-alignment: center;
            color: touch.has-hover ? Theme.text-primary : Theme.text-secondary;
            animate color { duration: Theme.fast; }
        }
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The big status circle. Breathes while work is in progress; colour tells the state.
export component StatusOrb inherits Rectangle {
    in property <Phase> phase;

    property <bool> busy: root.phase == Phase.checking || root.phase == Phase.fixing
        || root.phase == Phase.verifying || root.phase == Phase.restoring;
    property <color> tint: root.phase == Phase.ready || root.phase == Phase.restored ? Theme.success
        : root.phase == Phase.exam-mode ? Theme.exam
        : root.phase == Phase.failed ? Theme.danger
        : root.busy ? Theme.accent
        : Theme.neutral;
    property <string> glyph: root.phase == Phase.ready || root.phase == Phase.restored ? Icons.check
        : root.phase == Phase.exam-mode ? Icons.lock
        : root.phase == Phase.failed ? Icons.warning
        : root.busy ? Icons.sync
        : Icons.shield;
    // 0..1 breathing value; only reads animation-tick() while busy, so an idle window costs no CPU.
    property <float> breath: root.busy ? (Math.sin(animation-tick() / 1s * 200deg) + 1) / 2 : 0;

    width: 176px;
    height: 176px;

    halo := Rectangle {
        width: root.width * (0.84 + 0.16 * root.breath);
        height: self.width;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        border-radius: self.width / 2;
        background: root.tint.transparentize(0.88);
        animate background { duration: Theme.slow; }
    }

    ring := Rectangle {
        width: 136px;
        height: 136px;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        border-radius: self.width / 2;
        background: root.tint.transparentize(0.8);
        animate background { duration: Theme.slow; }
    }

    core := Rectangle {
        width: 104px;
        height: 104px;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        border-radius: self.width / 2;
        background: root.tint;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 10px;
        drop-shadow-color: root.tint.transparentize(0.6);
        animate background, drop-shadow-color { duration: Theme.slow; easing: ease-in-out; }

        // Note: no gradient highlight here - the software renderer does not clip gradients to
        // rounded corners, so it rendered as a square.

        Text {
            width: parent.width;
            height: parent.height;
            text: root.glyph;
            font-family: Theme.font-icons;
            font-size: 40px;
            color: #ffffff;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component StepRow inherits Rectangle {
    in property <string> label;
    in property <int> state;

    height: 30px;

    dot := Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: root.state == 2 ? Theme.success : transparent;
        border-width: root.state == 2 ? 0px : 1.5px;
        border-color: root.state == 1 ? Theme.accent : Theme.border-strong;
        animate background, border-color { duration: Theme.medium; }

        Text {
            width: parent.width;
            height: parent.height;
            text: Icons.check;
            font-family: Theme.font-icons;
            font-size: 9px;
            color: #ffffff;
            horizontal-alignment: center;
            vertical-alignment: center;
            opacity: root.state == 2 ? 1 : 0;
            animate opacity { duration: Theme.medium; }
        }

        // Pulsing centre while this step is the active one.
        Rectangle {
            property <float> pulse: root.state == 1 ? (Math.sin(animation-tick() / 1s * 300deg) + 1) / 2 : 0;
            width: 6px + 2px * self.pulse;
            height: self.width;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: self.width / 2;
            background: Theme.accent;
            opacity: root.state == 1 ? 1 : 0;
            animate opacity { duration: Theme.fast; }
        }
    }

    Text {
        x: 30px;
        height: parent.height;
        vertical-alignment: center;
        text: root.label;
        font-family: Theme.font-text;
        font-size: 14px;
        color: root.state == 0 ? Theme.text-tertiary : Theme.text-primary;
        animate color { duration: Theme.medium; }
    }
}

export component StepList inherits VerticalLayout {
    in property <[StepItem]> steps;
    spacing: 2px;
    for step in root.steps: StepRow {
        label: step.label;
        state: step.state;
    }
}

export component Toggle inherits Rectangle {
    in property <bool> checked;
    callback toggled(bool);

    width: 42px;
    height: 24px;
    border-radius: 12px;
    background: root.checked ? Theme.success : Theme.muted-fill;
    animate background { duration: Theme.medium; }

    Rectangle {
        width: 20px;
        height: 20px;
        y: 2px;
        x: root.checked ? root.width - self.width - 2px : 2px;
        border-radius: 10px;
        background: #ffffff;
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: #00000040;
        animate x { duration: Theme.medium; easing: cubic-bezier(0.2, 0, 0, 1); }
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.checked); }
    }
}

export component PlanRow inherits Rectangle {
    in property <PlanItem> item;
    callback toggled(bool);

    height: 62px;
    border-radius: 12px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.item.name;
                font-family: Theme.font-text;
                font-size: 14px;
                font-weight: 600;
                color: root.item.enabled ? Theme.text-primary : Theme.text-tertiary;
                overflow: elide;
                animate color { duration: Theme.medium; }
            }
            Text {
                text: root.item.category + "  ·  " + root.item.method;
                font-family: Theme.font-text;
                font-size: 12px;
                color: Theme.text-secondary;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            Toggle {
                checked: root.item.enabled;
                toggled(value) => { root.toggled(value); }
            }
        }
    }
}
