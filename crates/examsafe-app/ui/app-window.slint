// Main window: the one-click simple view, with the advanced view as a sheet that slides in.
import { Theme, Icons } from "theme.slint";
import { Phase, StepItem, PlanItem, PrimaryButton, LinkButton, StatusOrb, StepList, PlanRow } from "components.slint";

export { Phase, StepItem, PlanItem }

export component AppWindow inherits Window {
    title: "ExamSafe";
    preferred-width: 440px;
    preferred-height: 680px;
    min-width: 400px;
    min-height: 640px;
    background: Theme.background;
    default-font-family: Theme.font-text;

    in property <Phase> phase: Phase.idle;
    in property <string> profile-name: "SDU Digital Exam · closed book";
    in property <int> issue-count: 0;
    in property <string> failure-reason;
    in property <string> helper-status: "Not used yet";
    in property <[StepItem]> steps;
    in property <[PlanItem]> plan-items;
    in-out property <bool> advanced-open: false;

    callback primary-action();
    callback plan-item-toggled(int, bool);

    property <bool> busy: root.phase == Phase.checking || root.phase == Phase.fixing
        || root.phase == Phase.verifying || root.phase == Phase.restoring;

    pure function headline() -> string {
        if (root.phase == Phase.idle) { return "Ready when you are"; }
        if (root.phase == Phase.checking) { return "Checking your PC"; }
        if (root.phase == Phase.fixing) { return "Making it exam-safe"; }
        if (root.phase == Phase.verifying) { return "Double-checking"; }
        if (root.phase == Phase.ready) { return "Everything is ready"; }
        if (root.phase == Phase.exam-mode) { return "Exam mode is on"; }
        if (root.phase == Phase.restoring) { return "Restoring your PC"; }
        if (root.phase == Phase.restored) { return "Back to normal"; }
        return "Something needs attention";
    }

    pure function subline() -> string {
        if (root.phase == Phase.idle) { return "One click turns off everything your exam doesn't allow, and puts it all back afterwards."; }
        if (root.phase == Phase.checking) { return "Looking at apps, services, tasks, startup items, network and browsers."; }
        if (root.phase == Phase.fixing) { return "Turning off \{root.issue-count} things. Everything is recorded so it can be put back."; }
        if (root.phase == Phase.verifying) { return "Scanning again to prove nothing came back."; }
        if (root.phase == Phase.ready) { return "Close ExamSafe now. After your exam, open it again to restore everything."; }
        if (root.phase == Phase.exam-mode) { return "Your PC is still set up for an exam. Restore it when you're done."; }
        if (root.phase == Phase.restoring) { return "Turning your apps and services back on."; }
        if (root.phase == Phase.restored) { return "Everything that was on before is on again."; }
        return root.failure-reason;
    }

    pure function primary-label() -> string {
        if (root.busy) { return "Working…"; }
        if (root.phase == Phase.ready) { return "Close ExamSafe"; }
        if (root.phase == Phase.exam-mode) { return "Restore my PC"; }
        if (root.phase == Phase.restored) { return "Done"; }
        if (root.phase == Phase.failed) { return "Try again"; }
        return "Make my PC exam-safe";
    }

    pure function primary-tint() -> color {
        if (root.phase == Phase.ready || root.phase == Phase.restored) { return Theme.success; }
        if (root.phase == Phase.exam-mode) { return Theme.exam; }
        return Theme.accent;
    }

    // ----- Simple view -------------------------------------------------------------------
    simple := Rectangle {
        width: parent.width;
        height: parent.height;
        opacity: root.advanced-open ? 0 : 1;
        animate opacity { duration: Theme.medium; }

        VerticalLayout {
            padding: 28px;
            padding-top: 20px;
            spacing: 0px;

            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: "ExamSafe";
                    font-family: Theme.font-display;
                    font-size: 15px;
                    font-weight: 700;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                }
                Rectangle {
                    height: 28px;
                    width: profile-text.preferred-width + 24px;
                    border-radius: 14px;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    profile-text := Text {
                        x: 12px;
                        height: parent.height;
                        vertical-alignment: center;
                        text: root.profile-name;
                        font-size: 12px;
                        color: Theme.text-secondary;
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                alignment: center;
                StatusOrb { phase: root.phase; }
            }

            Rectangle { height: 26px; }

            Text {
                text: root.headline();
                font-family: Theme.font-display;
                font-size: 28px;
                font-weight: 700;
                color: Theme.text-primary;
                horizontal-alignment: center;
            }

            Rectangle { height: 8px; }

            Text {
                text: root.subline();
                font-size: 14px;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Rectangle { height: 22px; }

            // Fixed height so the layout never jumps when steps appear or disappear.
            Rectangle {
                height: 196px;
                opacity: root.busy ? 1 : 0;
                animate opacity { duration: Theme.medium; }
                HorizontalLayout {
                    alignment: center;
                    StepList {
                        width: 250px;
                        steps: root.steps;
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }

            PrimaryButton {
                text: root.primary-label();
                enabled: !root.busy;
                tint: root.primary-tint();
                clicked => { root.primary-action(); }
            }

            Rectangle { height: 10px; }

            HorizontalLayout {
                alignment: center;
                LinkButton {
                    text: "Advanced";
                    clicked => { root.advanced-open = true; }
                }
            }
        }
    }

    // ----- Advanced view (hidden unless opened) ----------------------------------------------
    sheet := Rectangle {
        x: root.advanced-open ? 0px : root.width;
        y: 0px;
        width: root.width;
        height: root.height;
        background: Theme.background;
        animate x { duration: Theme.slow; easing: cubic-bezier(0.2, 0, 0, 1); }

        VerticalLayout {
            padding: 22px;
            padding-top: 16px;
            spacing: 12px;

            HorizontalLayout {
                alignment: start;
                LinkButton {
                    icon: Icons.back;
                    text: "Back";
                    clicked => { root.advanced-open = false; }
                }
            }

            Text {
                text: "Advanced";
                font-family: Theme.font-display;
                font-size: 24px;
                font-weight: 700;
                color: Theme.text-primary;
            }

            Text {
                text: "Exactly what ExamSafe turns off for this exam. Switch an item off to leave it alone. Prototype: sample data.";
                font-size: 13px;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }

            Flickable {
                vertical-stretch: 1;
                content-width: self.width;
                content-height: plan-list.preferred-height;
                plan-list := VerticalLayout {
                    width: parent.width;
                    spacing: 8px;
                    for item[index] in root.plan-items: PlanRow {
                        item: item;
                        toggled(value) => { root.plan-item-toggled(index, value); }
                    }
                }
            }

            Rectangle { height: 1px; background: Theme.border; }

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Admin helper";
                    font-size: 12px;
                    font-weight: 600;
                    color: Theme.text-secondary;
                }
                Text {
                    text: root.helper-status;
                    font-size: 12px;
                    color: Theme.text-secondary;
                    horizontal-alignment: right;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
        }
    }
}
