// Main window: the one-click simple view, with the advanced view as a sheet that slides in.
import { Theme, Icons } from "theme.slint";
import { Phase, StepItem, PlanItem, PrimaryButton, LinkButton, StatusOrb, StepList, PlanRow, AppList } from "components.slint";

export { Phase, StepItem, PlanItem }

export component AppWindow inherits Window {
    title: "ExamSafe";
    preferred-width: 440px;
    preferred-height: 680px;
    min-width: 400px;
    min-height: 640px;
    background: Theme.background;
    default-font-family: Theme.font-text;

    in property <Phase> phase: Phase.idle;
    in property <string> profile-name: "SDU Digital Exam · closed book";
    in property <int> issue-count: 0;
    in property <string> failure-reason;
    in property <bool> exam-mode-active: false;
    // Apps shown on the confirm screen (will close) and in exam mode (will reopen).
    in property <[string]> app-names;
    in property <[StepItem]> steps;
    in property <[PlanItem]> plan-items;
    in-out property <bool> advanced-open: false;

    callback primary-action();
    callback secondary-action();
    callback plan-item-toggled(int, bool);

    // What this version really covers. Shown wherever the app could otherwise over-promise.
    out property <string> scope-note: "This version closes apps. Services, scheduled tasks, startup items and browser extensions are not handled yet.";

    property <bool> busy: root.phase == Phase.checking || root.phase == Phase.fixing
        || root.phase == Phase.verifying || root.phase == Phase.restoring;
    property <bool> shows-apps: (root.phase == Phase.confirm || root.phase == Phase.exam-mode) && root.app-names.length > 0;

    pure function headline() -> string {
        if (root.phase == Phase.idle) { return "Ready when you are"; }
        if (root.phase == Phase.checking) { return "Checking your PC"; }
        if (root.phase == Phase.confirm) { return root.issue-count == 1 ? "Close 1 app?" : "Close \{root.issue-count} apps?"; }
        if (root.phase == Phase.fixing) { return "Closing apps"; }
        if (root.phase == Phase.verifying) { return "Double-checking"; }
        if (root.phase == Phase.ready) { return root.issue-count == 0 ? "Nothing to close" : "Apps are closed"; }
        if (root.phase == Phase.exam-mode) { return "Exam mode is on"; }
        if (root.phase == Phase.restoring) { return "Restoring your PC"; }
        if (root.phase == Phase.restored) { return "Back to normal"; }
        return "Something needs attention";
    }

    pure function subline() -> string {
        if (root.phase == Phase.idle) { return "Closes the apps your exam doesn't allow, checks they stay closed, and reopens them afterwards."; }
        if (root.phase == Phase.checking) { return "Looking for apps your exam doesn't allow."; }
        if (root.phase == Phase.confirm) { return "Save your work in these apps first. They close now and reopen when you restore."; }
        if (root.phase == Phase.fixing) { return "Asking apps to close. Anything that doesn't respond is closed after a few seconds."; }
        if (root.phase == Phase.verifying) { return "Scanning again to prove nothing came back."; }
        if (root.phase == Phase.ready && root.issue-count == 0) { return "None of the apps on the exam list are running. Close ExamSafe before your exam."; }
        if (root.phase == Phase.ready) { return "Checked again: none of them came back. Close ExamSafe now, and open it after your exam to reopen your apps."; }
        if (root.phase == Phase.exam-mode && root.app-names.length > 0) { return "When your exam is over, these apps will be reopened:"; }
        if (root.phase == Phase.exam-mode) { return "Your PC is still set up for an exam. Restore it when you're done."; }
        if (root.phase == Phase.restoring) { return "Reopening your apps."; }
        if (root.phase == Phase.restored) { return "Everything ExamSafe closed has been reopened."; }
        return root.failure-reason;
    }

    pure function primary-label() -> string {
        if (root.busy) { return "Working…"; }
        if (root.phase == Phase.confirm) { return "Close apps"; }
        if (root.phase == Phase.ready) { return "Close ExamSafe"; }
        if (root.phase == Phase.exam-mode) { return "Restore my PC"; }
        if (root.phase == Phase.restored) { return "Done"; }
        if (root.phase == Phase.failed) { return "Try again"; }
        return "Make my PC exam-safe";
    }

    pure function primary-tint() -> color {
        if (root.phase == Phase.ready || root.phase == Phase.restored) { return Theme.success; }
        if (root.phase == Phase.exam-mode) { return Theme.exam; }
        return Theme.accent;
    }

    // The small link under the button: a real choice where one exists, otherwise Advanced.
    pure function secondary-label() -> string {
        if (root.phase == Phase.confirm) { return "Cancel"; }
        if (root.phase == Phase.failed && root.exam-mode-active) { return "Restore my PC instead"; }
        return "Advanced";
    }

    // ----- Simple view -------------------------------------------------------------------
    simple := Rectangle {
        width: parent.width;
        height: parent.height;
        opacity: root.advanced-open ? 0 : 1;
        animate opacity { duration: Theme.medium; }

        VerticalLayout {
            padding: 28px;
            padding-top: 20px;
            spacing: 0px;

            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: "ExamSafe";
                    font-family: Theme.font-display;
                    font-size: 15px;
                    font-weight: 700;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                }
                Rectangle {
                    height: 28px;
                    width: profile-text.preferred-width + 24px;
                    border-radius: 14px;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    profile-text := Text {
                        x: 12px;
                        height: parent.height;
                        vertical-alignment: center;
                        text: root.profile-name;
                        font-size: 12px;
                        color: Theme.text-secondary;
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                alignment: center;
                StatusOrb { phase: root.phase == Phase.confirm ? Phase.idle : root.phase; }
            }

            Rectangle { height: 24px; }

            Text {
                text: root.headline();
                font-family: Theme.font-display;
                font-size: 28px;
                font-weight: 700;
                color: Theme.text-primary;
                horizontal-alignment: center;
            }

            Rectangle { height: 8px; }

            Text {
                text: root.subline();
                font-size: 14px;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Rectangle { height: 18px; }

            // Fixed height so the layout never jumps between states.
            Rectangle {
                height: 196px;

                Rectangle {
                    opacity: root.busy ? 1 : 0;
                    animate opacity { duration: Theme.medium; }
                    HorizontalLayout {
                        alignment: center;
                        StepList {
                            width: 290px;
                            steps: root.steps;
                        }
                    }
                }

                AppList {
                    x: 16px;
                    y: 0px;
                    width: parent.width - 32px;
                    height: min(parent.height, self.names.length * 30px + 26px);
                    names: root.app-names;
                    visible: root.shows-apps;
                }

                Text {
                    x: 12px;
                    width: parent.width - 24px;
                    height: parent.height;
                    vertical-alignment: bottom;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    text: root.scope-note;
                    font-size: 12px;
                    color: Theme.text-tertiary;
                    visible: root.phase == Phase.idle || root.phase == Phase.ready;
                }
            }

            Rectangle { vertical-stretch: 1; }

            PrimaryButton {
                text: root.primary-label();
                enabled: !root.busy;
                tint: root.primary-tint();
                clicked => { root.primary-action(); }
            }

            Rectangle { height: 10px; }

            HorizontalLayout {
                alignment: center;
                LinkButton {
                    text: root.secondary-label();
                    clicked => {
                        if (root.secondary-label() == "Advanced") {
                            root.advanced-open = true;
                        } else {
                            root.secondary-action();
                        }
                    }
                }
            }
        }
    }

    // ----- Advanced view (hidden unless opened) ----------------------------------------------
    sheet := Rectangle {
        x: root.advanced-open ? 0px : root.width;
        y: 0px;
        width: root.width;
        height: root.height;
        background: Theme.background;
        animate x { duration: Theme.slow; easing: cubic-bezier(0.2, 0, 0, 1); }

        VerticalLayout {
            padding: 22px;
            padding-top: 16px;
            spacing: 12px;

            HorizontalLayout {
                alignment: start;
                LinkButton {
                    icon: Icons.back;
                    text: "Back";
                    clicked => { root.advanced-open = false; }
                }
            }

            Text {
                text: "Advanced";
                font-family: Theme.font-display;
                font-size: 24px;
                font-weight: 700;
                color: Theme.text-primary;
            }

            Text {
                text: root.plan-items.length == 0
                    ? "None of the apps on the exam list are running right now."
                    : "Apps on the exam list that are running right now. Switch one off to leave it open.";
                font-size: 13px;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }

            // A plain Rectangle takes all spare height (a Flickable alone won't grow past its
            // content, which spread the texts above apart when the list was short).
            Rectangle {
                vertical-stretch: 1;
                Flickable {
                    width: parent.width;
                    height: parent.height;
                    content-width: self.width;
                    content-height: plan-list.preferred-height;
                    plan-list := VerticalLayout {
                        width: parent.width;
                        spacing: 8px;
                        for item[index] in root.plan-items: PlanRow {
                            item: item;
                            toggled(value) => { root.plan-item-toggled(index, value); }
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: Theme.border; }

            Text {
                text: root.scope-note;
                font-size: 12px;
                color: Theme.text-tertiary;
                wrap: word-wrap;
            }
        }
    }
}
