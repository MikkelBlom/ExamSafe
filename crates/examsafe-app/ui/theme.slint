// Design tokens. Every colour, size and duration used by the UI comes from here, in both
// light and dark mode (follows the Windows setting).
import { Palette } from "std-widgets.slint";

export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    // Surfaces
    out property <color> background: root.dark ? #0f0f11 : #f5f5f7;
    out property <color> surface: root.dark ? #1c1c1e : #ffffff;
    out property <color> surface-hover: root.dark ? #2a2a2d : #ebebef;
    out property <color> border: root.dark ? #2c2c2e : #e2e2e7;
    out property <color> border-strong: root.dark ? #48484a : #c7c7cc;
    out property <color> muted-fill: root.dark ? #3a3a3c : #dcdce1;

    // Text
    out property <color> text-primary: root.dark ? #f5f5f7 : #1d1d1f;
    out property <color> text-secondary: root.dark ? #a1a1a6 : #6e6e73;
    out property <color> text-tertiary: root.dark ? #636366 : #aeaeb2;

    // Meaning
    out property <color> accent: root.dark ? #0a84ff : #0071e3;
    out property <color> success: root.dark ? #2fb84f : #28a745;
    out property <color> exam: root.dark ? #5e5ce6 : #5856d6;
    out property <color> danger: root.dark ? #ff453a : #e5372c;
    out property <color> neutral: root.dark ? #636366 : #8e8e93;

    // Type
    out property <string> font-text: "Segoe UI Variable Text";
    out property <string> font-display: "Segoe UI Variable Display";
    out property <string> font-icons: "Segoe Fluent Icons";

    // Motion
    out property <duration> fast: 160ms;
    out property <duration> medium: 280ms;
    out property <duration> slow: 420ms;
}

// Segoe Fluent Icons code points.
export global Icons {
    out property <string> shield: "\u{E83D}";
    out property <string> check: "\u{E73E}";
    out property <string> lock: "\u{E72E}";
    out property <string> warning: "\u{E7BA}";
    out property <string> sync: "\u{E895}";
    out property <string> back: "\u{E72B}";
}
