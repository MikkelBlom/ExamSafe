{
  "version": 1,
  "notes": "Generic rules shipped with ExamSafe. Put personal additions in config/my-profile.json instead of editing this file. Match fields use PowerShell -like wildcards (* and ?), case-insensitive. A rule's action defaults to its category's action.",
  "categories": {
    "ai":             { "label": "AI assistants & AI tooling",           "action": "stop",   "description": "Chatbots, AI desktop apps, local LLM servers, AI dictation, MCP servers." },
    "remoteAccess":   { "label": "Remote access & screen sharing",       "action": "stop",   "description": "Anything that lets another person see or control this PC." },
    "communication":  { "label": "Chat & messaging",                     "action": "stop",   "description": "Messaging apps that could receive help during the exam." },
    "deviceLink":     { "label": "Phone & device linking",               "action": "stop",   "description": "Phone mirroring, cross-device clipboard and file drop." },
    "cloudSync":      { "label": "Cloud file sync",                      "action": "stop",   "description": "Folders that can receive files from outside during the exam." },
    "overlay":        { "label": "Launchers, overlays & screen tools",   "action": "stop",   "description": "Pop-up launchers, always-on-top tools, screen capture/recording." },
    "virtualization": { "label": "Virtual machines & containers",        "action": "stop",   "description": "VMs/WSL/Docker. Lockdown browsers often refuse to run next to them." },
    "work":           { "label": "Work & dev background jobs",           "action": "stop",   "description": "Databases, dev servers, work automation. Not cheating, but noise you do not want mid-exam." },
    "gaming":         { "label": "Gaming launchers & extras",            "action": "stop",   "description": "Launchers with chat/overlays, animated wallpapers." },
    "network":        { "label": "VPN & network tunnels",                "action": "review", "description": "Might be needed (school VPN) or might be a problem. Decide per exam." },
    "browser":        { "label": "Web browsers",                         "action": "review", "description": "Often needed for the exam itself, but extensions (AI sidebars) are a risk." },
    "devTools":       { "label": "Editors & IDEs",                       "action": "review", "description": "Usually allowed in programming exams, but check for AI plugins (Copilot etc.)." },
    "media":          { "label": "Music & media",                        "action": "review", "description": "Rarely a rule issue, but some proctoring flags audio apps." },
    "custom":         { "label": "Your own rules",                       "action": "review", "description": "Rules you added from the ExamSafe window." },
    "hardware":       { "label": "Drivers & hardware utilities",         "action": "allow",  "description": "Keyboard, mouse, GPU, audio, tablet and laptop vendor tools." },
    "security":       { "label": "Antivirus & security",                 "action": "allow",  "description": "Never turned off by ExamSafe." },
    "system":         { "label": "Windows & runtime components",         "action": "allow",  "description": "Shells, runtimes and Windows components (includes ExamSafe itself)." }
  },
  "rules": [
    { "id": "claude", "label": "Claude (desktop, Cowork, Chrome bridge)", "category": "ai", "match": [
      { "type": "process", "name": "claude", "relaunch": true },
      { "type": "process", "name": "cowork-svc" },
      { "type": "process", "name": "chrome-native-host", "path": "*\\Claude\\*" },
      { "type": "service", "name": "CoworkVMService" } ] },
    { "id": "chatgpt", "label": "ChatGPT / Codex desktop", "category": "ai", "match": [
      { "type": "process", "name": "ChatGPT", "relaunch": true },
      { "type": "process", "name": "Codex" },
      { "type": "process", "name": "codex" } ] },
    { "id": "copilot", "label": "Microsoft Copilot app", "category": "ai", "match": [
      { "type": "process", "name": "mscopilot" },
      { "type": "process", "name": "Copilot" },
      { "type": "process", "name": "M365Copilot" },
      { "type": "startup", "name": "MicrosoftCopilotAutoLaunch*" } ] },
    { "id": "wispr-flow", "label": "Wispr Flow (AI dictation)", "category": "ai", "match": [
      { "type": "process", "name": "Wispr Flow", "relaunch": true },
      { "type": "process", "name": "Wispr Flow Helper" },
      { "type": "startup", "name": "*Wispr*" } ] },
