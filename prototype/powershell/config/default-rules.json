      { "type": "process", "name": "lms" },
      { "type": "process", "name": "gpt4all*" },
      { "type": "process", "name": "Jan" },
      { "type": "port", "port": 11434 },
      { "type": "port", "port": 1234 },
      { "type": "startup", "name": "*Ollama*" } ] },
    { "id": "ai-editors", "label": "AI-first editors (Cursor, Windsurf, Zed AI)", "category": "ai", "match": [
      { "type": "process", "name": "Cursor" },
      { "type": "process", "name": "Windsurf" } ] },
